<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.secondbrain.dailysync</string>

  <key>ProgramArguments</key>
  <array>
    <!-- Deterministic-only sync (no Claude Code required): -->
    <string>{{SECOND_BRAIN_BIN}}</string>
    <string>sync</string>
    <string>--connector</string>
    <string>x_bookmarks</string>
    <!-- For the Claude Code-native version (source interpretation, richer
         claim extraction), replace ProgramArguments with a wrapper script
         that runs: claude -p "/daily-sync" --settings headless-settings.json
         See claude/README.md. -->
  </array>

  <key>WorkingDirectory</key>
  <string>{{VAULT_ROOT}}</string>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>7</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>{{VAULT_ROOT}}/Outputs/Logs/launchd-dailysync.out.log</string>
  <key>StandardErrorPath</key>
  <string>{{VAULT_ROOT}}/Outputs/Logs/launchd-dailysync.err.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>{{PATH}}</string>
    <key>HOME</key>
    <string>{{HOME}}</string>
    <key>SECOND_BRAIN_VAULT</key>
    <string>{{VAULT_ROOT}}</string>
  </dict>

  <key>RunAtLoad</key>
  <false/>
  <key>KeepAlive</key>
  <false/>

  <!-- StartCalendarInterval fires even if the Mac was asleep at 07:00 (launchd
       runs it on next wake). It does NOT fire retroactively across a full
       missed day if the Mac stayed asleep through 07:00 - there is no
       persistent daily guarantee stronger than "runs when the Mac is awake
       at or after 07:00." That's an honest limitation, not a bug - build a
       separate watchdog job if you need multi-day-miss detection. -->
</dict>
</plist>
